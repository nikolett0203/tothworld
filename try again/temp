
.hero, .projects, .about-me {
    position: absolute;
    height: 100%;
    width: 100%;
    left: 0; 

    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.hero {
    top: 0;
    
}

.about-me {
    top: 100%;
}

.projects {
    top: 200%;
}

h1 {
    color: rgb(230, 229, 230);
    font-size: 3.3em;
    font-family: cormorant;
    font-weight: 600;
    padding-bottom: 30px;

    text-align: center;

    /* Glow + depth */
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.8),
                 0 0 30px rgba(100, 200, 255, 0.5),
                 0 0 50px rgba(100, 200, 255, 0.3);

    animation: floaty 5s ease-in-out infinite;
    animation: floaty 5s ease-in-out infinite, pulseGlow 3s ease-in-out infinite;
}

p {
    animation: floaty 5s ease-in-out infinite;
    color:white;
    /* animation: floaty 5s ease-in-out infinite, pulseGlow 3s ease-in-out infinite; */
}

@keyframes floaty {
    0%, 100% {
        transform: translateY(0) rotate(0deg);
    }
    50% {
        transform: translateY(-15px) rotate(1deg);
    }
}

@keyframes pulseGlow {
    0%, 100% {
        text-shadow: 0 0 15px rgba(255, 255, 255, 0.8),
                     0 0 30px rgba(100, 200, 255, 0.5),
                     0 0 50px rgba(100, 200, 255, 0.3);
    }
    50% {
        text-shadow: 0 0 25px rgba(255, 255, 255, 1),
                     0 0 40px rgba(150, 220, 255, 0.7),
                     0 0 70px rgba(150, 220, 255, 0.5);
    }
}
